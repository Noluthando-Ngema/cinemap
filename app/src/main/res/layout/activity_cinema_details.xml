<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- topbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_previous"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cinema Map"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- cinema image -->
        <ImageView
            android:id="@+id/imgCinema"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/cinema_aurora"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card_rounded"/>

        <!-- rating -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ 4.8 (1,230 reviews)"
            android:textColor="#E0D4FF"
            android:textSize="12sp"
            android:layout_marginStart="16dp"/>

        <!-- name -->
        <TextView
            android:id="@+id/tvCinemaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starlight\nMultiplex"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="4dp"/>

        <!-- address -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:text="📍"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="123 Nebula Way, Cosmopolis"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="16dp">

            <Button
                android:id="@+id/btnDirections"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="Get Directions"
                android:drawableStart="@android:drawable/ic_menu_directions"
                android:drawablePadding="6dp"
                android:backgroundTint="#E0D4FF"
                android:textColor="#0B1020"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="Call Cinema"
                android:drawableStart="@android:drawable/ic_menu_call"
                android:drawablePadding="6dp"
                android:backgroundTint="#1F263B"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- features row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:weightSum="4">

            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="☕" android:gravity="center" android:background="@drawable/bg_circle_icon"/>
                <TextView android:text="Cafe" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="♿" android:gravity="center" android:background="@drawable/bg_circle_icon"/>
                <TextView android:text="Accessible" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="P" android:gravity="center" android:background="@drawable/bg_circle_icon" android:textStyle="bold"/>
                <TextView android:text="Parking" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:text="I" android:gravity="center" android:background="@drawable/bg_circle_icon" android:textStyle="bold"/>
                <TextView android:text="IMAX" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <!-- about -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Experience cinema like never before at Starlight Multiplex. Featuring state-of-the-art laser projection, immersive Dolby Atmos sound, and luxurious reclining seats in every auditorium.\n\nEnjoy our curated selection of gourmet snacks and craft beverages at the lobby lounge before your film begins."
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:layout_margin="16dp"/>

        <!-- map preview -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>