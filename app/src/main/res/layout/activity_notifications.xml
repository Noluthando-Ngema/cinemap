<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorBackground">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnHome"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_previous"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="CineMap"
            android:textColor="?attr/colorOnBackground"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="🔔"
            android:gravity="center"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="👤"
            android:gravity="center"
            android:background="@drawable/bg_circle_icon"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notifications"
        android:textColor="?attr/colorOnBackground"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvUnread"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="You have 0 unread alerts."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btnMarkAll"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✓"
            android:gravity="center"
            android:background="@drawable/bg_circle_icon"
            android:textColor="?attr/colorOnBackground"/>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:id="@+id/chipAll"
                android:text="All"
                android:padding="8dp"
                android:background="@drawable/bg_chip_selected"
                android:textColor="#0B1020"
                android:layout_marginEnd="8dp"
                android:textSize="12sp"/>
            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:id="@+id/chipTickets"
                android:text="Tickets"
                android:padding="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="8dp"
                android:textSize="12sp"/>
            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:id="@+id/chipRewards"
                android:text="Rewards"
                android:padding="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="8dp"
                android:textSize="12sp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/notificationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav"/>
</LinearLayout>