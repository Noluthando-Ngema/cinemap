<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1020">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView android:id="@+id/btnBack" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_media_previous"/>
        <TextView android:text="Payment" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginStart="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- order summary card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="16dp">

                <TextView android:text="Order Summary" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                    <ImageView android:layout_width="48dp" android:layout_height="64dp" android:src="@android:drawable/ic_menu_gallery" android:background="@drawable/bg_input_rounded"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                        <TextView android:id="@+id/tvMovieTitle" android:text="The Last Cartographer" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvFormat" android:text="IMAX Laser" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:id="@+id/tvSeatsInfo" android:text="2x Adult Tickets" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1F263B" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/tvTicketsLabel" android:text="Tickets (2)" android:textColor="#AAAAAA" android:textSize="13sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvSubtotal" android:text="R400" android:textColor="#AAAAAA" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView android:text="Service Fee" android:textColor="#AAAAAA" android:textSize="13sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                    <TextView android:text="R50" android:textColor="#AAAAAA" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView android:text="Total" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvTotal" android:text="R450" android:textColor="#7DFF9B" android:textStyle="bold" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- payment method -->
            <TextView android:text="Payment Method" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <LinearLayout android:id="@+id/cardVisa" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_payment_selected" android:padding="12dp" android:layout_marginTop="12dp" android:gravity="center_vertical">
                <TextView android:text="VISA" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:background="#1A1F71" android:padding="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:text="•••• 4242" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Expires 12/25" android:textColor="#888888" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:id="@+id/checkVisa" android:text="●" android:textColor="#E0D4FF" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardApple" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_payment_unselected" android:padding="12dp" android:layout_marginTop="8dp" android:gravity="center_vertical">
                <TextView android:text="🍎" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/bg_circle_icon" android:layout_marginEnd="0dp"/>
                <TextView android:text="Apple Pay" android:textColor="#FFFFFF" android:textSize="13sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/checkApple" android:text="○" android:textColor="#555555" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardGoogle" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_payment_unselected" android:padding="12dp" android:layout_marginTop="8dp" android:gravity="center_vertical">
                <TextView android:text="GPay" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/bg_circle_icon"/>
                <TextView android:text="Google Pay" android:textColor="#FFFFFF" android:textSize="13sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/checkGoogle" android:text="○" android:textColor="#555555" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnAddCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:layout_marginTop="8dp" android:gravity="center_vertical">
                <TextView android:text="+" android:textColor="#888888" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text=" Add New Card" android:textColor="#888888" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- confirm button -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#0B1020" android:padding="16dp">
        <Button
            android:id="@+id/btnConfirmPay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🔒 Confirm &amp; Pay R450"
            android:backgroundTint="#E0D4FF"
            android:textColor="#0B1020"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>